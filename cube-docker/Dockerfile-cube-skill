# =============================================================================
# Agent CLI-based Computer Image — Skill-Enhanced CubeSandbox
# =============================================================================
# This image extends cubesandbox-base with ALL pre-installed dependencies
# required by the agent skills in skills/public/. Building everything into
# the image eliminates per-task pip/npm installs at runtime, making sandbox
# startup for skill-aided tasks near-instant.
#
# Skills covered:
#   uniai-docx       — python-docx, PyMuPDF, LibreOffice, poppler
#   uniai-pdf        — pypdf, pdfplumber, reportlab, pytesseract, pypdfium2
#   uniai-xlsx       — openpyxl (pandas from base)
#   pptx-plus-linux  — pptxgenjs, sharp, pdf-lib (npm); python-pptx, markitdown
#   data-insight-viz — ECharts (npm); scipy/seaborn (Python analysis)
#   canvas-design    — Playwright (from base), canvas-fonts
#   frontend-design  — no extra runtime deps
#   webapp-testing   — Playwright (from base)
#   dws              — prebuilt binary, no extra deps
#
# Build:
#   docker build --platform=linux/amd64 -t openagent-sandbox-skill -f Dockerfile-cube-skill .
#
# Register as Cube template:
#   cubemastercli tpl create-from-image \
#     --image openagent-sandbox-skill:latest \
#     --writable-layer-size 4G \
#     --expose-port 49999 \
#     --expose-port 49983 \
#     --probe 49999 \
#     --probe-path /health
# =============================================================================

# Single-stage build on cubesandbox-base (ubuntu:22.04, Python 3.10).
FROM ghcr.io/tencentcloud/cubesandbox-base:2026.16

ARG DEBIAN_FRONTEND=noninteractive

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    IS_SANDBOX=yes \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    CODE_INTERPRETER_HOST=0.0.0.0 \
    CODE_INTERPRETER_PORT=49999 \
    CODE_INTERPRETER_WORKDIR=/workspace \
    JUPYTER_HOST=127.0.0.1 \
    JUPYTER_PORT=8888 \
    PATH=/home/openagent/.npm-global/bin:/home/openagent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

USER root

# =============================================================================
# System Packages — full toolchain for document processing, OCR, PDF, LaTeX
# =============================================================================
RUN sed -i 's@//.*archive.ubuntu.com@//mirrors.tuna.tsinghua.edu.cn@g; s@//.*security.ubuntu.com@//mirrors.tuna.tsinghua.edu.cn@g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || \
    sed -i 's@//.*archive.ubuntu.com@//mirrors.tuna.tsinghua.edu.cn@g; s@//.*security.ubuntu.com@//mirrors.tuna.tsinghua.edu.cn@g' /etc/apt/sources.list 2>/dev/null || true && \
    apt-get update && apt-get install -y --no-install-recommends \
    # Core utilities (from base, plus extras)
    bash coreutils wget curl git jq tree ripgrep \
    zip unzip file findutils patch sqlite3 \
    # Build deps for Python C extensions
    python3 python3-dev python3-pip python3-venv \
    build-essential pkg-config \
    libffi-dev zlib1g-dev libpng-dev libfreetype-dev libbz2-dev \
    libssl-dev libreadline-dev libsqlite3-dev \
    libjpeg-dev libtiff-dev libwebp-dev libopenjp2-7-dev \
    libcairo2-dev libpango1.0-dev libglib2.0-dev \
    libxml2-dev libxslt1-dev libhdf5-dev \
    # Runtime libs for numpy/pillow/matplotlib/cairo
    libffi8 zlib1g libpng16-16 libfreetype6 libbz2-1.0 \
    libglib2.0-0 libcairo2 libpango-1.0-0 \
    libjpeg-turbo8 libtiff5 libwebp7 libopenjp2-7 \
    # PDF tools (uniai-pdf: pdftotext, pdfimages, etc.)
    poppler-utils \
    # PDF manipulation (uniai-pdf: merge/split/decrypt)
    qpdf \
    # OCR (uniai-pdf: scanned document processing)
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-chi-sim \
    tesseract-ocr-chi-tra \
    # Document conversion (uniai-docx/pdf/xlsx rendering)
    pandoc \
    # Media / image processing
    imagemagick \
    graphviz \
    ffmpeg \
    # LaTeX (data-insight-viz: report generation, pdf forms)
    texlive-base \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-xetex \
    # Fonts: comprehensive CJK + Latin (all skills with Chinese output)
    fonts-liberation2 fonts-dejavu \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    fonts-freefont-ttf \
    fonts-lmodern \
    # X Virtual Framebuffer (for headless browser screenshot/render)
    xvfb x11-xkb-utils xfonts-base xfonts-scalable \
    xfonts-cyrillic xfonts-utils \
    # Libraries for Playwright/Chrome (Ubuntu 22.04 — no t64 suffix)
    libnss3 libnss3-tools \
    libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 \
    libpango-1.0-0 libcairo2 libatspi2.0-0 \
    libgtk-3-0 libgtk-4-1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# =============================================================================
# LibreOffice (docx/pdf/xlsx/pptx conversion rendering)
#   - uniai-docx: `render_docx.py` uses soffice for visual re-check
#   - uniai-xlsx: `recalc.py` uses soffice for formula recalculation
#   - pptx-plus-linux: uses soffice for merge/pack validation
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    libreoffice-draw \
    libreoffice-common \
    libreoffice-java-common \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# =============================================================================
# Node.js 22.x
# =============================================================================
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# =============================================================================
# Python — Code-interpreter stack (required for the sandbox API)
# =============================================================================
RUN pip3 install --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    jupyter_server ipykernel \
    fastapi uvicorn httpx websockets pydantic

# =============================================================================
# Python — Data science + core utilities
# =============================================================================
RUN pip3 install --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    numpy pandas matplotlib pillow \
    requests beautifulsoup4 lxml \
    uv click pyyaml python-dotenv tabulate \
    playwright

# =============================================================================
# Python — Document processing (all document-oriented skills)
# =============================================================================
# uniai-docx:
#   python-docx ......... create/edit DOCX with styles, tables, fonts
#   pymupdf ............. PDF->PNG rendering (pure wheel, no poppler needed)
#   pdf2image ........... fallback PDF->PNG when PyMuPDF unavailable
# uniai-pdf:
#   pypdf ............... merge, split, rotate, encrypt/decrypt PDFs
#   pdfplumber .......... extract text & tables from PDFs
#   reportlab ........... create PDFs from scratch (CJK via CID fonts)
#   pytesseract ......... OCR for scanned PDFs (chi_sim+eng)
#   pypdfium2 ........... fast PDF rendering (Chromium PDFium backend)
# uniai-xlsx:
#   openpyxl ............ xlsx with formulas, styles, charts, formatting
# pptx-plus-linux:
#   python-pptx ......... read/analyze PPTX template structure
#   markitdown .......... extract text content from PPTX/DOCX
# canvas-design:
#   Wand ................ ImageMagick binding for image processing
RUN pip3 install --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    python-docx \
    pymupdf \
    pdf2image \
    pypdf \
    pdfplumber \
    reportlab \
    pytesseract \
    pypdfium2 \
    openpyxl \
    python-pptx \
    markitdown \
    Wand

# =============================================================================
# Python — Data visualization & analysis (data-insight-viz)
# =============================================================================
# scipy: advanced statistical analysis (pandas complement)
# seaborn: statistical visualization (matplotlib complement)
# xlsxwriter: writing formatted xlsx with charts (pandas.to_excel engine)
RUN pip3 install --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    scipy \
    seaborn \
    xlsxwriter

# =============================================================================
# NPM Global Packages — All skill-related npm modules
# =============================================================================
# pptx-plus-linux:
#   pptxgenjs ........... PPTX generation from JavaScript (core)
#   sharp ............... image resize/convert for slide assets
# data-insight-viz:
#   echarts ............. chart rendering (primary viz library)
# uniai-pdf:
#   pdf-lib ............. PDF creation/editing from JS
# uniai-docx:
#   docx ................ DOCX generation from JS
# General:
#   marked .............. Markdown parsing (no external downloads)
#   react, react-dom, react-icons  UI rendering (used by pptx-gen)
#   typescript, tsx ..... TS compilation/runtime
# NOTE: markdown-pdf and @mermaid-js/mermaid-cli are intentionally excluded
#   — they pull deprecated phantomjs-prebuilt / puppeteer Chromium binaries
#   from github.com which time out in CN build environments. Neither is
#   referenced by any skill in skills/public/.
RUN npm config set registry https://registry.npmmirror.com && \
    npm config set prefix /home/openagent/.npm-global && \
    npm install -g \
    pptxgenjs@4.0.1 \
    sharp \
    pdf-lib@1.17.1 \
    echarts \
    docx@9.5.1 \
    marked \
    react \
    react-dom \
    react-icons \
    typescript \
    tsx \
    playwright \
    && echo "PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers" >> /home/openagent/.npmrc \
    && rm -rf /root/.npm/_cacache

# =============================================================================
# Install Playwright Chromium browser (shared between Node.js and Python)
# =============================================================================
# Downloads ~150MB Chromium to /opt/pw-browsers. Uses npmmirror's Playwright
# mirror (PLAYWRIGHT_DOWNLOAD_HOST) because the default azureedge.net host is
# slow/unreachable from CN build environments.
#
# 'npx playwright install-deps chromium' runs apt-get to install the remaining
# Chromium runtime deps (libnss3, libatk, etc. — most already installed above).
RUN PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright \
    npx playwright install chromium && \
    npx playwright install-deps chromium

# =============================================================================
# Code-interpreter FastAPI app + launcher
# =============================================================================
COPY lightweight-code-interpreter-server.py /opt/lightweight-code-interpreter/server.py
COPY start-code-interpreter.sh /usr/local/bin/start-code-interpreter.sh
RUN chmod +x /usr/local/bin/start-code-interpreter.sh

# =============================================================================
# Register Python kernel + finalize
# =============================================================================
RUN python3 -m ipykernel install --user --name python3

# Strip debug symbols from compiled extensions (saves ~30-50MB)
RUN find /usr/lib/python3 -name "*.so" -type f -exec strip --strip-unneeded {} \; 2>/dev/null || true

# =============================================================================
# ImageMagick policy + python symlink + mount points + sessions
# =============================================================================
RUN if [ -f /etc/ImageMagick-6/policy.xml ]; then \
        sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/' /etc/ImageMagick-6/policy.xml; \
    fi && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    mkdir -p /workspace /mnt/uploads /mnt/outputs /mnt/skills /sessions && \
    chmod 755 /sessions && \
    # systemd-sysv 被某个依赖包拉进来了，它在 microVM 里会导致内核启动失败
    # 删除 /sbin/init 避免内核尝试启动 systemd
    rm -f /sbin/init /lib/systemd/systemd && \
    rm -rf /tmp/* /var/tmp/* /root/.cache /root/.npm

WORKDIR /workspace

EXPOSE 49983 49999

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cube-entrypoint.sh"]
CMD ["/usr/local/bin/start-code-interpreter.sh"]
