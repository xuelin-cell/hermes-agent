# 复制成 entry.env（已 gitignore）。值一律不要进 git。
# --- Entry PostgreSQL（本地端口只绑定 127.0.0.1）---
MT_POSTGRES_DB=hermes_entry
MT_POSTGRES_USER=hermes_entry
MT_POSTGRES_PASSWORD=hermes-local-dev
MT_POSTGRES_PORT=15432
MT_DATABASE_URL=postgresql://hermes_entry:hermes-local-dev@postgres:5432/hermes_entry
# 用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成；写入数据后保持不变
MT_CREDENTIAL_KEY=REPLACE_WITH_FERNET_KEY
# --- 租户容器 ---
MT_IMAGE=hermes-custom:dev
MT_PREFIX=hermes
MT_MEMORY=2g
MT_CPUS=1
MT_PIDS=512
MT_IDLE_MINUTES=30
MT_TZ=Asia/Shanghai
# --- MaaS ---
MT_MAAS_APP=https://maas.ai-yuanjing.com/app
MT_MYPLAN_URL=https://maas.ai-yuanjing.com/app/gateway/uniwork/my-plan
MT_LOGIN_APPLICATION=uniwork
# --- 模型（写进每个租户的 config.yaml）---
MT_MODEL_BASE_URL=https://maas-api.ai-yuanjing.com/openapi/compatible-mode/v1
MT_MODEL=deepseek-v4-flash
# --- 内置的元景 MCP（搜图、文生图等工具，写进每个租户的 config.yaml；不写就用这几个默认值）---
# MT_YUANJING_MCP_URL=https://maas.ai-yuanjing.com/app/mcp-server/mcp   # 设成空 = 不提供
# MT_YUANJING_MCP_CLIENT_ID=UniWork   # 要在元景 mcp-server 的白名单里，否则套餐 key 调下游回 1004
# MT_YUANJING_MCP_OSS_MODE=internal   # 工具产出的文件给内网链接（用户的浏览器在内网）；设成空 = 公网链接
# --- 企业模式：接 UNIWORK 企业管理平台（不写 = 个人套餐模式）---
# 填了以后，短信登录交给平台、按企业发设备令牌；模型走平台 /v1，元景 MCP 走平台中转，用量记在企业账上。
# 入口和用户实例都用这个地址连平台；平台是私网 IP 时，新建的实例会自动放行这个地址（沙箱默认挡私网）。
# MT_UNIWORK_SERVER=http://192.168.0.50:11220
# MT_CUBE_ALLOW_OUT=            # 额外放行的私网地址段，逗号分隔，如 10.1.2.3/32；只对新建的实例生效
# MT_UNIWORK_PLUGIN=0           # 一键停用实例里的企业对接插件（会话头、工具调用上报、产物上传、A2A）；不写 = 开着
# 平台调用云端运行智能体（docs/企业版对接/15）：和平台的 UNIWORK_CLOUD_RUNTIME_SECRET 同一个值，不配就整组接口 404
# MT_UNIWORK_SERVICE_SECRET=
# MT_UNIWORK_SERVICE_ALLOW=192.168.0.50   # 只放行平台地址，逗号分隔；留空不限来源（仍要密钥）
# 服务接口另开的监听（只转服务接口这组路径）：平台和 MT_HTTP_PORT 不在一个网段、回包会走错网卡时用。
# 必须写成 IP:端口；配了它，上面两项也必须配（deploy.sh 会检查）。.7 上是 192.168.0.7:18081。
# MT_SERVICE_HTTP_PORT=
# --- 统一登录（docs/企业版对接/1104，entry/sso.py；不写 = 入口自己的短信登录）---
# 开了以后入口不再自己登录：网关验完登录，用身份请求头（X-Uid / X-Account-Type / X-Tenant-Id / X-Sid）告诉入口是谁。
# 个人版和企业版各开各的；页面地址、退出、切换账号都走网关的 /login/。
# MT_SSO=1
# 网关 nginx 访问这套服务时的来源地址（我们的 nginx 记成 X-Real-IP），逗号分隔，IP 或网段。不写 = 谁的身份头都不信：
# 写错了所有人都进不来，入口日志里会记下被拒的来源地址。
# MT_SSO_TRUSTED=
# 个人版：网关 12.4 的完整地址和密钥（网关那边是 MAAS_CREDENTIAL_TOKEN）。按会话取 MaaS 令牌，只放入口内存。
# MT_SSO_CREDENTIAL_URL=http://<网关内网地址>/app/gateway/sso/internal/maas-credential
# MT_SSO_CREDENTIAL_TOKEN=
# 企业版：调企业管理平台 /api/internal/sso/device-token 换设备令牌的密钥（平台那边是 UNIWORK_CLOUD_INTERNAL_TOKEN）。
# MT_UNIWORK_INTERNAL_TOKEN=
# 网关登录页，不写就是 /login/。页面要去登录页时都先到入口的 /agents/login，由入口跳到这里，退出页最后也跳这里。
# 网关下 /agents/login、/agents/logout 走静态上游（企业版入口 18081），所以以那台入口的配置为准
# MT_SSO_LOGIN_URL=/login/
# --- 会话 ---
MT_COOKIE_SECURE=0
# --- 沙箱后端（deploy.sh init 会生成这一段）---
# MT_BACKEND=cube
# MT_CUBE_API=http://<控制面>:3000
# MT_CUBE_PROXY=http://<数据面>
# MT_CUBE_DOMAIN=cube.app
# MT_CUBE_TEMPLATE=              # 由 ./deploy.sh template 填，tpl- 开头的 ID（别名比不了模板是否变了）
# MT_CUBE_VOLUME_MOUNT=/mnt/u    # 用户卷挂进实例的位置，在 hermes 数据目录之外
# MT_HTTP_PORT=192.168.x.x:18081 # 页面只绑内网 IP，必须带 IP
# MT_ARCHIVE_INTERVAL_S=300      # 状态管家多久归档一次（有改动才打）
# MT_IDLE_DELETE_HOURS=0         # 暂停后再空闲这么久就排空并删实例，0 = 不删（建议 24）
# MT_CUBE_PRIVATE_TRAFFIC=0      # 1 = 新建的实例关闭数据面公开访问，每个请求要带平台发的流量令牌（入口加密存 PG）
# MT_PG_LOCK=1                   # 变更实例时加 PG 咨询锁，入口多副本也不会给一个用户建两台；单副本可设 0
# MT_CRON_WAKE_LEAD_S=90         # 定时任务：实例停着时提前这么多秒叫醒它，0 = 不叫（任务只在实例开着时跑）
# MT_CRON_KEEPALIVE_S=300        # 回收前问忙不忙：任务在跑、回合在跑、或前后这么多秒内有任务到点就先不暂停
# --- 卷外第二份副本（四项都填才启用；凭据只给读卷前缀 + 写备份前缀的权限）---
# MT_BACKUP_S3_ENDPOINT=https://<桶的内网端点>
# MT_BACKUP_S3_BUCKET=<桶名>
# MT_BACKUP_S3_ACCESS_KEY=
# MT_BACKUP_S3_SECRET_KEY=
# MT_BACKUP_S3_REGION=us-east-1  # 端点要求的区域名（华为 OBS 写它的区域）
# MT_BACKUP_S3_PATH_STYLE=1      # 1 = http://端点/桶/键；0 = 桶名做子域名
# MT_BACKUP_VOLUME_PREFIX=volumes/        # 卷在桶里的前缀（卷插件决定）
# MT_BACKUP_PREFIX=backups/hermes-mt/     # 副本放哪，实例碰不到
# MT_BACKUP_INTERVAL_H=24        # 多久一轮
# MT_BACKUP_KEEP_DAYS=7          # 保留几天（每天一份）
# MT_BACKUP_KEEP_WEEKS=4         # 再保留几周（每周一份）；最新一份永远留
# --- deploy.sh 专用（都有默认值）---
# MT_DEPLOY_REGISTRY=<控制面主机>:5000   集群镜像仓库
# MT_DEPLOY_BASE_IMAGE=   一般不写：默认用 all / base 按 hermes 源码指纹自动构建的 hermes-custom:src-<指纹>
# MT_DEPLOY_TPL_CPU=1000   不写时普通版 1000，企业版（配了 MT_UNIWORK_SERVER）2000
# MT_DEPLOY_TPL_MEM=2000
# MT_DEPLOY_TPL_DISK=8G
# MT_DEPLOY_BRANCH=release
# MT_DEPLOY_FWD_PORT=15000
# --- 开发模式（生产必须为 0）：任意用户名直接登录，模型 key 用 MT_DEV_API_KEY ---
MT_DEV_LOGIN=0
MT_DEV_API_KEY=

# Optional centralized 5G text connector (Cube + MT_PG_LOCK=1).
# Keep empty until the same cloud Agent has been disconnected from UniClaw.
MT_CHANNELS_KEY=
# 旧版 5G 附件链接的兼容入口；新附件经元景 MCP 上传 OSS，不再需要配置。
MT_CHANNELS_MEDIA_BASE_URL=
# Optional gateway origin allowlist for SMS login and central service provisioning.
MT_CHANNELS_GATEWAY_ORIGINS=

# Langfuse upstream is fixed in code to https://www.yjworker.10010.com/langfuse;
# it has no environment-variable override.
# Opt in to automatic plugin enablement and credential provisioning at bootstrap.
# Entry origin reachable from user instances, WITHOUT /agents or /api path.
# Docker example: http://hermes-mt-entry:9400 (verify its tenant-network DNS name).
# Cube: use a reachable HTTPS Entry origin. Empty disables capture and relay.
MT_LANGFUSE_ENTRY_URL=
