# 每个租户首次建卷时由入口服务写入 /opt/data/config.yaml（{{...}} 由入口替换）。
# 之后属于用户自己，入口不再覆盖。模型 key 在同目录 .env 的 {{KEY_ENV_NAME}} 里。
# 平台管的几段（模型端点与清单、上下文长度、下面的平台策略）每次引导时还会按平台的再写一遍，
# 见 seed/mtstate.py 的 apply_platform_block。
_config_version: 39

model:
  default: "{{MODEL_NAME}}"
  provider: "{{PROVIDER_KEY}}"
  base_url: "{{MODEL_BASE_URL}}"
  key_env: "{{KEY_ENV_NAME}}"

providers:
  {{PROVIDER_KEY}}:
    api: "{{MODEL_BASE_URL}}"
    key_env: "{{KEY_ENV_NAME}}"
    transport: chat_completions
    default_model: "{{MODEL_NAME}}"
    # 套餐里全部可选模型；由入口按 my-plan 下发的清单渲染/同步，带上每个模型的上下文长度。
    # 只写 default_model 的话，界面的模型下拉只会看到一个。
    models:
{{MODELS_BLOCK}}

terminal:
  backend: "local"
  cwd: "{{FILES_ROOT}}"
  timeout: 180

dashboard:
  public_url: ""

# 平台策略：不拉在线模型目录（集群里访问慢、会卡住模型下拉），不在用到时临时装依赖包，
# 第一条消息时不提出建用户画像（off 要加引号：hermes 按 YAML 1.1 读，不加会读成 false）。
model_catalog:
  enabled: false
security:
  allow_lazy_installs: false
onboarding:
  profile_build: "off"

{{REASONING_BLOCK}}

cloud_sharing:
  enabled: true
cloud_drive:
  enabled: true
cloud_mail:
  enabled: true

mcp_servers:
  Agent-Mail:
    url: "http://127.0.0.1:9120/api/plugins/cloud-mail/mcp"
    enabled: false
    uniwork_managed: "uniwork.cloud.mail.v1"
    timeout: 120
    headers:
      X-Hermes-Session-Token: "${HERMES_DASHBOARD_SESSION_TOKEN}"
  UniWork-Drive:
    url: "http://127.0.0.1:9120/api/plugins/cloud-drive/mcp"
    timeout: 720
    execution_metadata: true
    strict_redirect_headers: true
    uniwork_managed: "uniwork.desktop.drive.v1"
    headers:
      X-Hermes-Session-Token: "${HERMES_DASHBOARD_SESSION_TOKEN}"
