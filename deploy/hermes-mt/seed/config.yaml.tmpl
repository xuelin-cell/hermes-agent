# 每个租户首次建卷时由入口服务写入 /opt/data/config.yaml（{{...}} 由入口替换）。
# 之后属于用户自己，入口不再覆盖。模型 key 在同目录 .env 的 {{KEY_ENV_NAME}} 里。
# 平台管的几段（模型端点与清单、上下文长度、下面的平台策略）每次引导时还会按平台的再写一遍，
# 见 seed/mtstate.py 的 apply_platform_block。
_config_version: 39

model:
  default: "{{MODEL_NAME}}"
  provider: "{{PROVIDER_KEY}}"
  base_url: "{{MODEL_BASE_URL}}"
  key_env: "{{KEY_ENV_NAME}}"

providers:
  {{PROVIDER_KEY}}:
    api: "{{MODEL_BASE_URL}}"
    key_env: "{{KEY_ENV_NAME}}"
    transport: chat_completions
    default_model: "{{MODEL_NAME}}"
    # 套餐里全部可选模型；由入口按 my-plan 下发的清单渲染/同步，带上每个模型的上下文长度。
    # 只写 default_model 的话，界面的模型下拉只会看到一个。
    models:
{{MODELS_BLOCK}}

terminal:
  backend: "local"
  cwd: "{{FILES_ROOT}}"
  timeout: 180

dashboard:
  public_url: ""

# 平台策略：不拉在线模型目录（集群里访问慢、会卡住模型下拉），不在用到时临时装依赖包。
model_catalog:
  enabled: false
security:
  allow_lazy_installs: false

{{REASONING_BLOCK}}
