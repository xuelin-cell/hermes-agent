# 沙箱（CubeSandbox）用的薄封装镜像。
#
# 设计原则：基础镜像用本仓库根目录的 Dockerfile 构建（见 README「基础镜像」），这里只在它之上叠一层。
# 这一层把「对所有用户都一样」的东西全部固化进镜像，好让平台那边需要按用户
# 支持的口子尽可能少。
#
# 固化了什么：
#   - 8 个所有用户相同的环境变量（第 9 个 HERMES_DASHBOARD_SESSION_TOKEN 每人不同，
#     由入口在创建后通过 /__mt/bootstrap 送进来，不能进镜像 —— 镜像是共享且要分发的）
#   - 启动命令
#   - 转发器本体（放在 /opt/mt，**不在数据卷里**。原先它放在用户可写的 /opt/data/.mt/，
#     意味着租户能替换掉它；挪进镜像层一并解决）
#   - 对外端口：只有一个
#   - envd —— 平台创建沙箱时若带了环境变量，镜像里没有 envd 会导致**创建直接失败**，
#     所以必须打进来，即使我们并不使用它的命令/文件/终端能力
#   - 内置技能要用的程序和库（LibreOffice、Python 库、Playwright 的无头浏览器、pptxgenjs）。
#     技能本身随基础镜像（/opt/hermes/skills/uniwork）
#   - 本分支对 hermes 源码的改动（overlay.list 列的仓库路径，按原路径覆盖进 /opt/hermes，见下面那段）
#
# 为什么 CMD 只起转发器、不起 hermes：
#   平台下发创建时环境变量是在容器进程已经起来之后（起容器 → 探针 → 创建后处理 → 下发变量），
#   hermes 缺了会话令牌会直接退出，进程一死探针永远不通，沙箱根本建不起来。
#   所以让秒级启动的转发器先顶上让探针过，hermes 由引导接口拉起。细节见 seed/forward.py。
#
# 构建（在 deploy/hermes-mt/ 下）：
#   docker build -f Dockerfile.cube -t hermes-mt-cube:dev .
#
# 注册成模板：
#   cubemastercli tpl create-from-image \
#     --image <推到集群能拉到的仓库>/hermes-mt-cube:dev \
#     --writable-layer-size 2G \
#     --expose-port 9121 --expose-port 49983 \
#     --probe 9121 --probe-path /__mt/health
#
#   探针指向转发器而不是 hermes：转发器不依赖任何用户数据，秒级就绪，
#   模板快照因此能早做、冷启动更快。

ARG BASE_IMAGE=hermes-custom:dev
ARG CUBE_BASE=ghcr.io/tencentcloud/cubesandbox-base:2026.16

FROM ${CUBE_BASE} AS cubebase

FROM ${BASE_IMAGE}

USER root

# ---- 办公文档与系统浏览器 ---------------------------------------------------
# 在基础镜像上补齐文件预览和内置技能要用的系统程序：
#   - LibreOffice headless：文件面板的 Word / Excel / PPT 预览先转成 PDF（seed/mtuser.py），
#     uniai-docx / uniai-xlsx / uniai-ppt 技能的渲染、重算、转 PDF 也靠 `soffice`。
#     libreoffice-{calc,writer,impress} 拆分安装，比整套 libreoffice 元包小很多。
#   - poppler-utils：pdftoppm / pdftocairo，把 PDF 拆成 PNG（pdf2image 也走它）。
#   - chromium：系统浏览器 /usr/bin/chromium，frontend-design 技能按 `command -v chromium` 找它截图。
#     hermes 自己的浏览器工具用基础镜像里 pm 锁定的那份（/opt/hermes/tools/chromium-*）。
#   - fonts-noto-cjk / fonts-noto-color-emoji：LibreOffice 渲染和浏览器截图里的中文、emoji 不再是方块。
# 云端大包从国内 Debian 镜像下载；保留发行版、组件和签名校验。
RUN --mount=type=cache,id=hermes-apt-trixie,target=/var/cache/apt,sharing=locked \
    if [ -f /etc/apt/apt.conf.d/docker-clean ]; then mv /etc/apt/apt.conf.d/docker-clean /tmp/hermes-docker-clean; fi; \
    sed -i \
        -e 's|deb\.debian\.org|mirrors.tuna.tsinghua.edu.cn|g' \
        -e 's|security\.debian\.org|mirrors.tuna.tsinghua.edu.cn|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-calc \
        libreoffice-writer \
        libreoffice-impress \
        libreoffice-core \
        poppler-utils \
        chromium \
        fonts-noto-cjk \
        fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/* && \
    if [ -f /tmp/hermes-docker-clean ]; then mv /tmp/hermes-docker-clean /etc/apt/apt.conf.d/docker-clean; fi

# ---- 内置技能要用的 Python 库，装进 hermes 的 venv -------------------------------
# 技能脚本在实例里直接 import 这些库；venv 没有 pip，hermes 用户也装不了，所以预装（hermes 自己不用它们）。
# uv 用基础镜像里 pm 锁定的那份（pm 不把它放上 PATH）。-c 把 venv 里已有的包钉在现有版本：新装的库
# 不会顺带改动 hermes 自己的依赖，非改不可时构建直接失败。版本写死：同一个指纹构建出的镜像才一样。
#   uniai-docx：python-docx、pdf2image、PyMuPDF   uniai-pdf：pypdf、pdfplumber、reportlab
#   uniai-xlsx：openpyxl、pandas                   uniai-ppt：python-pptx、markitdown[pptx]、PyMuPDF、lxml
#   data-insight-viz：duckdb、openpyxl             maishou、skill-creator：PyYAML
#   canvas-design、webapp-testing：playwright（浏览器见下一段）
#   Pillow、requests、aiohttp、defusedxml 已是 hermes 自己的依赖。没装的是可选功能，缺了技能会跳过：
#   uniai-ppt 把 SVG 转 PNG 的 svglib（reportlab 新版出图还要从源码编 pycairo）、uniai-pdf 的 OCR。
RUN --mount=type=cache,id=hermes-python-uv,target=/root/.cache/uv,sharing=locked \
    set -eu; \
    uv="$(ls /opt/hermes/tools/uv-*/uv)"; \
    "$uv" pip freeze --python /opt/hermes/.venv/bin/python --exclude-editable > /tmp/hermes-pins.txt; \
    "$uv" pip install --cache-dir /root/.cache/uv --python /opt/hermes/.venv/bin/python -c /tmp/hermes-pins.txt \
        python-docx==1.2.0 pdf2image==1.17.0 PyMuPDF==1.28.2 \
        pypdf==6.19.0 pdfplumber==0.11.10 reportlab==5.0.1 \
        openpyxl==3.1.5 pandas==3.0.6 duckdb==1.5.6 \
        python-pptx==1.0.2 "markitdown[pptx]==0.1.8" lxml==6.1.2 \
        PyYAML==6.0.3 playwright==1.58.0; \
    rm -f /tmp/hermes-pins.txt /opt/hermes/.venv/.lock

# ---- Python 版 Playwright 的浏览器 ----------------------------------------------
# canvas-design、webapp-testing 技能截图自检用 `p.chromium.launch()`（默认无头，走 headless shell）。
# playwright 锁在 1.58.0：它认的 Chromium 修订号 1208 正是基础镜像里 pm 锁定的那份，完整 Chromium
# 直接共用，这里只多下 headless shell。PLAYWRIGHT_BROWSERS_PATH 指着 pm 的工具目录 /opt/hermes/tools，
# playwright install 默认会把那里它不认识的 chromium-* / ffmpeg-* 当旧版本删掉，所以必须带
# PLAYWRIGHT_SKIP_BROWSER_GC=1。装完起一次无头浏览器，再确认 pm 的 Chromium 和 ffmpeg 都还在。
# 下载源：部署机连不上 Playwright 的 CDN（10-15 实测，cdn.playwright.dev 跳转后超时），headless shell 和
# Playwright 自带的 ffmpeg 改从 npmmirror 下（目录结构和官方一样）。Playwright 不校验下载内容，这里按 sha256
# 核对这两个文件（和官方那份逐字节相同）；换 Playwright 版本时这两个值要跟着换。
ARG PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/chrome-for-testing
ARG PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
RUN set -eu; \
    PLAYWRIGHT_SKIP_BROWSER_GC=1 /opt/hermes/.venv/bin/playwright install chromium; \
    printf '%s  %s\n' \
        27e55cc30e487493b89b663085d6deeb0707be201a568657c922fac9076c317c /opt/hermes/tools/chromium_headless_shell-1208/chrome-headless-shell-linux64/chrome-headless-shell \
        460d44f3416005662f528d4b92e7b94ace924e8a0288106d3803b73c56eaadc8 /opt/hermes/tools/ffmpeg-1011/ffmpeg-linux \
        | sha256sum -c -; \
    /opt/hermes/.venv/bin/python -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(); pg = b.new_page(); pg.set_content("<p>ok</p>"); assert pg.inner_text("p") == "ok"; b.close(); p.stop()'; \
    /opt/hermes/.venv/bin/python -c 'from pm import installed_package; gone = [n for n in ("chromium", "ffmpeg") if not installed_package(n).binary.is_file()]; assert not gone, gone'

# ---- 内置技能要用的 Node 包 -------------------------------------------------------
# uniai-ppt 用 pptxgenjs 生成 PPT（agent 写的脚本里 `require("pptxgenjs")`）。hermes 用户装不了全局包，
# 预装到 /opt/skill-node，NODE_PATH 让任何目录下的脚本都 require 得到。不装进 npm 默认的全局目录：
# 那是 pm 管的工具目录。
RUN npm install -g --prefix /opt/skill-node --no-audit --no-fund pptxgenjs@4.0.1 && npm cache clean --force
ENV NODE_PATH=/opt/skill-node/lib/node_modules

# ---- 登录 shell 的 PATH -------------------------------------------------------------
# agent 的终端命令在登录 shell 里跑，/etc/profile 会把 PATH 重置成系统默认值，镜像 ENV 里放在前面的
# /opt/hermes/bin（hermes 命令）、/opt/hermes/.venv/bin（带上面这些库的 Python）、/opt/data/.local/bin 都丢了，
# python3 落到 pm 那份不带库的 Python，技能脚本 import 不到库（旧镜像也是这样）。hermes 自己的设计是这几项在
# PATH 上（它给子进程去掉 VIRTUAL_ENV 时就假定 venv 仍在 PATH 上）；转发器给用户开的终端不用登录 shell，本来就有。
# 这里让登录 shell 把它们补回来，两边的 python3 是同一个；环境被整个清掉的登录（su -l）也补上 NODE_PATH。
RUN printf '%s\n' \
        'case ":$PATH:" in *:/opt/hermes/.venv/bin:*) ;; *) PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:$PATH" ;; esac' \
        'export NODE_PATH="${NODE_PATH:-/opt/skill-node/lib/node_modules}"' \
        > /etc/profile.d/hermes-path.sh && chmod 0644 /etc/profile.d/hermes-path.sh

# ---- envd 与 Cube 的通用入口脚本 ------------------------------------------
# 入口脚本的契约：后台拉起 envd（让平台的 SDK 数据面和默认探针可用），
# 然后前台 exec 我们给的命令。我们把上游镜像自己的 dispatcher 作为那条命令，
# 于是 s6 的 stage2 引导和降权到 hermes 用户这两件事一件都不少。
COPY --from=cubebase /usr/bin/envd /usr/bin/envd
COPY --from=cubebase /usr/local/bin/cube-entrypoint.sh /usr/local/bin/cube-entrypoint.sh
RUN chmod 0755 /usr/bin/envd /usr/local/bin/cube-entrypoint.sh

# ---- 转发器与状态管家 -------------------------------------------------------
# 放在镜像层而不是数据卷：卷是租户可写的，脚本放里面等于让租户能改自己的转发器。
# /mnt/u 是用户的 S3 卷的挂载点：挂在 hermes 数据目录之外，hermes 的仪表盘备份才不会
# 把整个卷打进可写层。工作区、附件、图片由状态管家做成指向卷内的目录链接。
RUN mkdir -p /opt/mt /mnt/u
COPY seed/forward.py /opt/mt/forward.py
COPY seed/mtexport.py /opt/mt/mtexport.py
COPY seed/mtstate.py /opt/mt/mtstate.py
COPY seed/mtuser.py /opt/mt/mtuser.py
COPY seed/mtfolders.py /opt/mt/mtfolders.py
COPY seed/mtmessaging.py /opt/mt/mtmessaging.py
COPY seed/mtconnectors.py /opt/mt/mtconnectors.py
COPY .connector-runtime/ /opt/mt/connectors/
RUN chmod 0644 /opt/mt/forward.py /opt/mt/mtstate.py /opt/mt/mtuser.py

# ---- 本分支对 hermes 源码的改动（overlay.list） -------------------------------
# 基础镜像就是用本仓库构建的，hermes 源码（含 skills/uniwork 内置技能）已在里面，所以清单现在是空的。
# 留着这条路给「不重建基础镜像、先改几个 hermes 文件」：/opt/hermes 是可编辑安装，且不留预编译缓存
# （PYTHONDONTWRITEBYTECODE=1），覆盖源文件就生效。deploy.sh 构建前把清单里的文件从仓库原样拷进
# .overlay/（构建目录，不进 git），构建后核对镜像里那份；tests/hermes_mt/test_image_overlay.py 核对清单本身。
COPY .overlay/ /opt/hermes/
COPY .kits-runtime/plugins/ /opt/hermes/plugins/

# ---- 所有用户相同的环境变量 -------------------------------------------------
# 与 entry/entry/tenants.py::_create 里那份清单保持一致。缺的那个
# HERMES_DASHBOARD_SESSION_TOKEN 每人不同，走引导接口。
ENV HERMES_HOME=/opt/data \
    HERMES_UID=10000 \
    HERMES_GID=10000 \
    TZ=Asia/Shanghai \
    TERMINAL_ENV=local \
    HERMES_DASHBOARD_FILES_ROOT=/opt/data/workspace \
    MT_FWD_PORT=9121 \
    MT_HERMES_PORT=9120

# 引导窗口：容器启动后多少秒内允许调 /__mt/bootstrap。
ENV MT_BOOTSTRAP_WINDOW_S=600
# 状态管家默认多久归档一次（入口可在引导时覆盖）。
ENV MT_ARCHIVE_INTERVAL_S=300
# hermes 的终端工具在第一条命令前会从 GitHub 下载 tirith（命令安全扫描器）到数据目录；
# 集群里的实例连不上 GitHub，下载挂住会让第一条命令卡几分钟（10-08 真机撞过）。
# 每人一台隔离的虚机，扫描的意义本来就不大，关掉。
ENV TIRITH_ENABLED=0

# 给 agent 的环境说明，进它的系统提示（hermes 专门留给宿主平台的口子，不占用户的 SOUL.md）。
# 工作区在对象存储上，小文件慢、没有硬链接；重活放本地盘的 scratch，成品再写回工作区。
# 用户在网页里用：写出的文件从输入框上方的预览条或文件面板打开，别建议 file://；实例里起的 localhost
# 服务用户的浏览器打不开；文件面板删的东西在卷上的回收站里留 7 天（见 seed/mtuser.py），用户要可以找回。
# 预览只打开那一个 HTML 文件，旁边单独的 .css / .js / 图片加载不到，所以网页要写成单个文件。
ENV HERMES_ENVIRONMENT_HINT="Environment notes: /opt/data/workspace is the user's persistent workspace. It lives on network object storage: many small files are slow there and hard links are not supported. Do heavy or temporary work (git clone, package installs, builds, scratch files) under /opt/data/scratch on the fast local disk, then copy finished results into the workspace. /opt/data/scratch is not preserved when the sandbox is recreated. The user talks to you through a web page in their browser, not a desktop app or a terminal on their own computer: files you write are opened from the preview bar above the chat input or from the Files panel, so never suggest file:// URLs or opening files with a local program. The preview opens a single HTML file on its own, so a web page you make must be self-contained: put its CSS and JavaScript inside the HTML file (inline <style> and <script>) and embed small images as data: URLs instead of separate files next to it. Web servers you start here (localhost ports) cannot be reached from the user's browser; deliver results as files instead. Files the user deletes in the Files panel go to /mnt/u/.trash and are kept for 7 days: each entry is a folder holding the item and a meta.json with its original path, so you can restore one on request by moving it back."

# 浏览器断开后，hermes 等多久才回收那条会话（还在跑的回合到时会被打断）。上游默认 20 秒：关掉浏览器
# 长任务就断。10-09 本机实测每条遗留会话约 4MB、不多出进程；定 1 小时。
ENV HERMES_TUI_WS_ORPHAN_REAP_GRACE_S=3600

# ---- 端口 -----------------------------------------------------------------
# 对外只有转发器这一个。hermes 自己绑 127.0.0.1:9120，故意不暴露 ——
# 它一旦发现自己绑在非回环地址就会强制开鉴权门，而浏览器版前端不说那套协议。
# 49983 是 envd，由平台自己用。
EXPOSE 9121
EXPOSE 49983

ENTRYPOINT [ "/usr/local/bin/cube-entrypoint.sh", "/opt/hermes/docker/entrypoint-dispatch.sh" ]
CMD [ "python3", "/opt/mt/forward.py" ]
