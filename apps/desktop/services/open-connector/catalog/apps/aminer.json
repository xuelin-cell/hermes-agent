          "author_org": {
            "type": "string",
            "minLength": 1,
            "description": "The scholar organization used to narrow an author-name match."
          },
          "aminer_author_id": {
            "type": "string",
            "minLength": 1,
            "description": "An AMiner scholar ID used as a recommendation seed."
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "The number of recommendations, from 1 to 20."
          }
        },
        "additionalProperties": true,
        "description": "Paper recommendation interests. Supply topics, author_name, or aminer_author_id.",
        "anyOf": [
          {
            "required": [
              "topics"
            ]
          },
          {
            "required": [
              "author_name"
            ]
          },
          {
            "required": [
              "aminer_author_id"
            ]
          }
        ]
      },
      "outputSchema": {
        "description": "Paper recommendations returned by AMiner."
