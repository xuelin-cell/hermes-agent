{
  "service": "wps_mcp",
  "displayName": "WPS Cloud Documents",
  "description": "Search, read, create, and edit Kingsoft documents through the official Skill Hub MCP service after browser authorization.",
  "categories": ["Productivity", "Storage"],
  "authTypes": ["custom_credential"],
  "auth": [{
    "type": "custom_credential",
    "interaction": "browser_poll",
    "fields": [
      {"key": "token", "label": "Authorization token", "inputType": "password", "required": true, "secret": true},
      {"key": "expiresAt", "label": "Token expiration", "inputType": "text", "required": true, "secret": false},
      {"key": "clientId", "label": "Installation ID", "inputType": "text", "required": true, "secret": false},
      {"key": "skillVersion", "label": "Skill version", "inputType": "text", "required": true, "secret": false}
    ]
  }],
  "homepageUrl": "https://www.wps.cn",
  "actions": [
    {"id": "wps_mcp.list_tools", "service": "wps_mcp", "name": "list_tools", "description": "Browse the official Kingsoft MCP tool catalog.", "requiredScopes": [], "providerPermissions": [], "inputSchema": {"type": "object", "properties": {"query": {"type": "string"}, "offset": {"type": "number", "minimum": 0}, "limit": {"type": "number", "minimum": 1, "maximum": 20}}, "additionalProperties": false}, "outputSchema": {"type": "object"}},
    {"id": "wps_mcp.get_tool_schema", "service": "wps_mcp", "name": "get_tool_schema", "description": "Get the schema for one discovered Kingsoft MCP tool.", "requiredScopes": [], "providerPermissions": [], "inputSchema": {"type": "object", "properties": {"toolName": {"type": "string", "minLength": 1}}, "required": ["toolName"], "additionalProperties": false}, "outputSchema": {"type": "object"}},
    {"id": "wps_mcp.call_tool", "service": "wps_mcp", "name": "call_tool", "description": "Call a discovered Kingsoft MCP tool once.", "requiredScopes": [], "providerPermissions": [], "inputSchema": {"type": "object", "properties": {"toolName": {"type": "string", "minLength": 1}, "arguments": {"type": "object", "additionalProperties": true}}, "required": ["toolName"], "additionalProperties": false}, "outputSchema": {"type": "object"}}
  ]
}
