  {
    "name": "list_recycle_bin",
    "description": "返回个人回收站的一页记录，delete_no 用于恢复或彻底删除。非空页按 next_page_no 继续翻页直到空页 end_reached=true，不能因短页停止；重复页或查询失败时不能声称已列完。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "page_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1
        },
        "page_size": {
          "type": "integer",
