  {
    "name": "download",
    "description": "下载当前授权账号的云盘文件到账号工作区，完成后返回实例内 path。读取云盘引用前先调用此工具，再读取 path；",
    "inputSchema": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "可选；省略时从文件详情获取。"
        }
      },
      "required": [
        "asset_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "upload",
    "description": "将当前用户实例上的任务文件或附件上传到个人云盘；相对路径基于账号工作区。禁止上传凭据等敏感文件。结果未知时先查询确认，不要直接重试。",
    "inputSchema": {
