[
  {
    "name": "list_files",
    "description": "仅返回个人云盘指定目录的一页直属文件和文件夹，不含子目录内容，根目录 ID 为 0。非空页按 next_page_no 继续翻页，直到空页 end_reached=true；has_more 是保守翻页提示。保持相同 page_size 和 sort；重复页或查询失败时应说明列表不完整，不能据此判断文件不存在。查看全部文件还需进入子目录。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "string",
          "enum": [
            "personal"
          ],
          "default": "personal"
        },
        "parent_asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "default": "0"
        },
        "page_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "sort": {
          "type": "string",
          "enum": [
            "name_asc",
            "modified_desc"
          ],
          "default": "name_asc"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "filesearch",
    "description": "按名称搜索个人云盘文件，等待后台全盘搜索完成后返回分页结果，最多约 11 分钟。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "page_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "make_dir",
    "description": "在个人云盘中创建文件夹。",
