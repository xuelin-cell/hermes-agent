  {
    "name": "delete_files",
    "description": "删除个人云盘资料。trash（默认）按 file_ids/directory_ids 移入回收站；purge 按 list_recycle_bin 返回的 delete_nos 彻底删除，不可恢复。结果未知时先查询确认，不要直接重试。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "trash",
            "purge"
          ],
          "default": "trash"
        },
        "file_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 100
        },
        "directory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 100
        },
        "delete_nos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "get_file_info",
